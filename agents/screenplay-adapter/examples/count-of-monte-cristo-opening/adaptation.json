    {
      "id": "S008",
      "episode": 1,
      "index_in_episode": 8,
      "beat": "complication",
      "beat_label": "复杂化",
      "duration_s": 120.0,
      "source": {
        "sentence_start": 39,
        "sentence_end": 46,
        "char_start": 940,
        "char_end": 1096,
        "chapter_ids": [
          "CH008"
        ],
        "paragraph_ids": [
          "P0008"
        ],
        "excerpt": "维尔福让唐泰斯先下去。 他独自坐在办公室里，拆开那封信。 收信人是他的父亲诺瓦蒂埃，一个拿破仑党人。 信里没有什么大阴谋，只有几行问候和一件旧事的嘱托。 可是这封信一旦公开，维尔福的仕途就完了。 他叫来宪兵队长，又让他先出去；然后看着烛火，把信的一角放到火苗上。 纸张卷曲、发黑。 他对自己说：“为了我的父亲，也为了我自己。”"
      },
      "cast": [
        "爱德蒙·唐泰斯",
        "维尔福",
        "宪兵队长"
      ],
      "expansion": [
